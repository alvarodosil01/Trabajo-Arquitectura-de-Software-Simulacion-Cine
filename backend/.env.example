# Copia de referencia de las variables de entorno. No pongas valores reales aquí:
# el fichero .env de verdad está en .gitignore y no se sube a GitHub.

# Secreto para firmar los tokens JWT (mínimo 32 caracteres). Genera uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Minutos de validez de cada token (por defecto 60)
JWT_EXPIRE_MINUTES=60

# Primer administrador. Se crea al arrancar solo si todavía no existe.
ADMIN_NOMBRE=Administrador
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Ruta de la base SQLite (opcional)
# DATABASE_URL=sqlite:///data/cine.db
